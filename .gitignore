# cloud-check's downloads and generated stubs are ignored by TDS_Mod/Tools/cloud-check/.gitignore
__pycache__/
*.pyc
# the game's binaries are never committed
*.dll
# never committed: Unity-generated folders and files, packages and archives, the PC's token, local Claude settings
Library/
Temp/
Logs/
UserSettings/
obj/
*.meta
*.unitypackage
*.zip
.modprojects_token
.claude/settings.local.json
# written on the PC by the build scripts and builders (the handoff tools skip them too)
TDS_Mod/ModSource/*/Build/
TDS_Mod/ModSource/*/build_log.txt
TDS_Mod/ModSource/*/Aseprite/generated/
TDS_Mod/ModSource/*/Previews/wip/
